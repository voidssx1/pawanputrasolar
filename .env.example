# Public site URL — used for canonical URLs, Open Graph, sitemap and robots.
# Set this to the live domain before deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. Any endpoint that accepts a JSON POST (Zapier, Make, Google Apps
# Script, CRM, Slack webhook). Leads are always appended to .data/leads.jsonl
# on a persistent server; the webhook is the delivery path for serverless hosts.
LEADS_WEBHOOK_URL=
